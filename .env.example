# Copia este archivo a ".env" y rellena tu clave.
# El archivo .env está en .gitignore y nunca se sube al repo.

# Clave de la API de Anthropic (Claude). Necesaria para generar noticias.
# Consíguela en https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Puerto del servidor (opcional, por defecto 3001)
PORT=3001

# Modelo a usar para generar noticias (opcional)
CLAUDE_MODEL=claude-sonnet-4-6
